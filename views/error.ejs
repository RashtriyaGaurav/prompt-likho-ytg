<!DOCTYPE html>
<html lang="en">

<head>
       <meta charset="UTF-8">
       <meta name="viewport" content="width=device-width, initial-scale=1.0">
       <title>AI Prompts for Gemini & ChatGPT | PromptLiko</title>

       <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

       <link rel="preconnect" href="https://fonts.googleapis.com">
       <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
       <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,500;9..144,600&family=Inter:wght@400;500&family=IBM+Plex+Mono:wght@400;500&display=swap"
              rel="stylesheet">

</head>

<body class="antialiased bg-black text-zinc-200">

       <div class="grain"></div>

       <div class="min-h-screen flex flex-col">

              <!-- Header -->
              <header class="border-b border-zinc-400 px-6 md:px-10 py-5 flex items-center justify-between">
                     <span class="font-mono text-xl tracking-[0.3em] uppercase text-muted">PromptLiko</span>
              </header>

              <main class="flex-1 max-w-7xl w-full mx-auto px-3 sm:px-4 md:px-10 py-12 md:py-16">

                     <div class="mb-6 max-w-2xl">
                            <p class="font-mono text-[11px] tracking-[0.3em] uppercase text-accent mb-4">
                                   Prompt Archive
                            </p>
                            <h1 class="font-display font-medium text-4xl md:text-5xl leading-[1.08] text-balance">
                                   Trending AI Prompts
                            </h1>
                            <p class="text-muted leading-relaxed mt-4 text-[15px] md:text-base">
                                   Portraits and scenes generated for Gemini and ChatGPT, with the exact prompt behind
                                   each one.
                            </p>

                            <div class="mt-4 text-zinc-300 flex gap-2 overflow-y-scroll [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
                            <a href="" class="bg-zinc-900 py-1 px-2 rounded-lg">All</a>
                            <a href="" class="bg-zinc-900 py-1 px-2 rounded-lg">Trending</a>
                            <a href="" class="bg-zinc-900 py-1 px-2 rounded-lg">Girl</a>
                            <a href="" class="bg-zinc-900 py-1 px-2 rounded-lg">Boy</a>
                            <a href="" class="bg-zinc-900 py-1 px-2 rounded-lg">Bike</a>
                            <a href="" class="bg-zinc-900 py-1 px-2 rounded-lg">Car</a>
                            <a href="" class="bg-zinc-900 py-1 px-2 rounded-lg">Cartoon</a>
                     </div>
                     </div>

                    

                     <% if (images.length===0) { %>

                            <div class="border border-hairline bg-surface py-24 px-6 text-center">
                                   <p class="font-mono text-[11px] tracking-[0.3em] uppercase text-muted mb-3">
                                          Archive&nbsp;Empty</p>
                                   <p class="font-display text-2xl text-ivory/80">No prompts uploaded yet.</p>
                            </div>

                            <% } else { %>

                                   <div class="grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4 md:gap-6">

                                          <% images.forEach((image, i)=> { %>

                                                 <a href="/image/<%= image.slug %>"
                                                        class="card group relative block border border-zinc-400 bg-surface">

                                                        <div class="relative overflow-hidden">
                                                               <img src="<%= image.image.url %>"
                                                                      class="card-img w-full h-90 object-top object-cover"
                                                                      alt="<%= image.seo.alt %>" loading="lazy">
                            
                                                        </div>

                                                        

                                                 </a>

                                                 <% }) %>

                                   </div>

                                   <% } %>

              </main>

              <footer class="border-t border-zinc-200 bg-white dark:bg-zinc-900 dark:border-zinc-800 w-full fixed bottom-0">
                     <nav aria-label="Footer navigation" class="mx-auto max-w-3xl">
                            <div class="flex justify-around items-center py-1 px-4">

                                   <a href="/" aria-label="Home"
                                          class="flex flex-col items-center gap-1 p-2 rounded-lg text-zinc-500 hover:text-zinc-900 hover:bg-zinc-100 dark:text-zinc-400 dark:hover:text-white dark:hover:bg-zinc-800 transition-colors duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-zinc-400">
                                          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                                                 stroke-width="1.5" stroke="currentColor" class="size-6"
                                                 aria-hidden="true">
                                                 <path stroke-linecap="round" stroke-linejoin="round"
                                                        d="m2.25 12 8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
                                          </svg>
                                   </a>

                                   <a href="/cart" aria-label="Cart"
                                          class="flex flex-col items-center gap-1 p-2 rounded-lg text-zinc-500 hover:text-zinc-900 hover:bg-zinc-100 dark:text-zinc-400 dark:hover:text-white dark:hover:bg-zinc-800 transition-colors duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-zinc-400">
                                          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                                                 stroke-width="1.5" stroke="currentColor" class="size-6"
                                                 aria-hidden="true">
                                                 <path stroke-linecap="round" stroke-linejoin="round"
                                                        d="M3.75 9.776c.112-.017.227-.026.344-.026h15.812c.117 0 .232.009.344.026m-16.5 0a2.25 2.25 0 0 0-1.883 2.542l.857 6a2.25 2.25 0 0 0 2.227 1.932H19.05a2.25 2.25 0 0 0 2.227-1.932l.857-6a2.25 2.25 0 0 0-1.883-2.542m-16.5 0V6A2.25 2.25 0 0 1 6 3.75h3.879a1.5 1.5 0 0 1 1.06.44l2.122 2.12a1.5 1.5 0 0 0 1.06.44H18A2.25 2.25 0 0 1 20.25 9v.776" />
                                          </svg>
                                   </a>

                                   <a href="/messages" aria-label="Messages"
                                          class="flex flex-col items-center gap-1 p-2 rounded-lg text-zinc-500 hover:text-zinc-900 hover:bg-zinc-100 dark:text-zinc-400 dark:hover:text-white dark:hover:bg-zinc-800 transition-colors duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-zinc-400">
                                          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                                                 stroke-width="1.5" stroke="currentColor" class="size-6"
                                                 aria-hidden="true">
                                                 <path stroke-linecap="round" stroke-linejoin="round"
                                                        d="M20.25 8.511c.884.284 1.5 1.128 1.5 2.097v4.286c0 1.136-.847 2.1-1.98 2.193-.34.027-.68.052-1.02.072v3.091l-3-3c-1.354 0-2.694-.055-4.02-.163a2.115 2.115 0 0 1-.825-.242m9.345-8.334a2.126 2.126 0 0 0-.476-.095 48.64 48.64 0 0 0-8.048 0c-1.131.094-1.976 1.057-1.976 2.192v4.286c0 .837.46 1.58 1.155 1.951m9.345-8.334V6.637c0-1.621-1.152-3.026-2.76-3.235A48.455 48.455 0 0 0 11.25 3c-2.115 0-4.198.137-6.24.402-1.608.209-2.76 1.614-2.76 3.235v6.226c0 1.621 1.152 3.026 2.76 3.235.577.075 1.157.14 1.74.194V21l4.155-4.155" />
                                          </svg>
                                   </a>

                            </div>
                     </nav>
              </footer>

       </div>

</body>

</html>
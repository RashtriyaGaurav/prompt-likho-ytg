       <style>
              :root {
                     --void: #0a0a0b;
                     --surface: #141416;
                     --hairline: #27272b;
                     --ivory: #eeeae1;
                     --muted: #9a9589;
                     --accent: #c69a5c;
                     --accent-dim: #8a6b3f;
              }

              body {
                     font-family: 'Inter', ui-sans-serif, system-ui, sans-serif;
              }

              .font-display {
                     font-family: 'Fraunces', ui-serif, Georgia, serif;
                     font-optical-sizing: auto;
              }

              .bg-void { background-color: var(--void); }
              .bg-surface { background-color: var(--surface); }
              .border-hairline { border-color: var(--hairline); }
              .text-ivory { color: var(--ivory); }
              .text-muted { color: var(--muted); }
              .text-accent { color: var(--accent); }
              .bg-accent { background-color: var(--accent); }
              .border-accent { border-color: var(--accent); }

              .grain {
                     position: fixed;
                     inset: 0;
                     pointer-events: none;
                     z-index: 40;
                     background:
                            radial-gradient(ellipse at 50% 0%, rgba(198, 154, 92, 0.05), transparent 60%),
                            radial-gradient(ellipse at 50% 100%, rgba(0, 0, 0, 0.5), transparent 55%);
              }

              a:focus-visible,
              button:focus-visible {
                     outline: 2px solid var(--accent);
                     outline-offset: 2px;
              }

              .card { transition: border-color 220ms ease; }
              .card:hover { border-color: var(--accent); }
              .card-img { transition: transform 500ms ease; }
              .card:hover .card-img { transform: scale(1.04); }

              @media (prefers-reduced-motion: reduce) {
                     .card, .card-img { transition: none; }
              }
       </style>

</head>

<body class="antialiased bg-void text-ivory">


                            <%
                                   // Each category maps to a real filter value used in the href.
                                   // `selectedCategory` should be passed in from the controller based on
                                   // the current query string (e.g. req.query.category) so the active
                                   // pill reflects what's actually being shown. Falls back to "All".
                                   const categories = [
                                          { label: 'All', value: '' },
                                          { label: 'Trending', value: 'trending' },
                                          { label: 'Girl', value: 'girl' },
                                          { label: 'Boy', value: 'boy' },
                                          { label: 'Anime Style', value: 'anime-style' },
                                          { label: 'Bike', value: 'bike' },
                                          { label: 'Car', value: 'car' },
                                          { label: 'Cartoon', value: 'cartoon' },
                                   ];
                                   const activeCategory = typeof selectedCategory !== 'undefined' ? selectedCategory : '';
                            %>

                            <nav
                                   aria-label="Filter prompts by category"
                                   class="mt-4 -mx-3 px-3 sm:mx-0 sm:px-0 flex gap-2 overflow-x-auto flex-nowrap [scrollbar-width:none] [&::-webkit-scrollbar]:hidden pb-1"
                            >
                                   <% categories.forEach(cat => { const isActive = activeCategory === cat.value; %>
                                   <a
                                          href="<%= cat.value ? '/?category=' + cat.value : '/' %>"
                                          aria-current="<%= isActive ? 'page' : 'false' %>"
                                          class="shrink-0 whitespace-nowrap font-mono text-xs tracking-wide uppercase py-1.5 px-3 border transition-colors <%= isActive ? 'bg-accent text-void border-accent' : 'border-hairline text-muted hover:text-ivory hover:border-accent' %>"
                                   >
                                          <%= cat.label %>
                                   </a>
                                   <% }) %>
                            </nav>
                     </div>

                     <% if (images.length===0) { %>

                            <div class="border border-hairline bg-surface py-24 px-6 text-center">
                                   <p class="font-mono text-[11px] tracking-[0.3em] uppercase text-muted mb-3">
                                          Archive&nbsp;Empty</p>
                                   <p class="font-display text-2xl text-ivory/80">No prompts uploaded yet.</p>
                            </div>

                            <% } else { %>

                                   <div class="grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4 md:gap-6">

                                          <% images.forEach((image, i)=> { %>

                                                 <a href="/image/<%= image.slug %>"
                                                        class="card group relative block border border-hairline bg-surface">

                                                        <div class="relative overflow-hidden">
                                                               <img src="<%= image.image.url %>"
                                                                      class="card-img w-full h-55 sm:h-90 object-top object-cover"
                                                                      alt="<%= image.seo.alt %>" loading="lazy">

                                                        </div>

                                                        <div class="p-2 sm:p-3">

                                                               <h2
                                                                      class="font-display hidden sm:block text-lg leading-snug line-clamp-2 text-ivory">
                                                                      <%= image.title %>
                                                               </h2>

                                                              <div class="flex justify-between items-center">
                                                                <p
                                                                      class="font-mono text-[10px] tracking-[0.2em] uppercase text-accent">
                                                                      <%= image.category.name %>
                                                               </p>
                                                               
                                                               <span class="flex items-center gap-1.5 font-mono text-sm">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8Z"></path>
                                    <circle cx="12" cy="12" r="3"></circle>
                                </svg>
                                <%= image.stats.views %>
                            </span>
                                                              </div>

                                                        </div>

                                                 </a>

                                                 <% }) %>

                                   </div>

                                   <% } %>

